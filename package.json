    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:collector": "tsc --noEmit --project tsconfig.collector.json",
    "db:migrate:local": "wrangler d1 migrations apply zzik-usage --local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
