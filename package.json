    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "miniflare": "5.20261109.0-beta",
    "pele": "^1.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "4.159.0"
  },
  "packageManager": "pnpm@12.14.0"
