    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.17",
    "jose": "^6.2.17",
    "ky": "^2.2.0",
    "lucide-react": "^1.71.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "uplot": "1.6.32",
    "zustand": "^5.1.0"
