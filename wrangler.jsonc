{
  "name": "zzik",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/pub/*"
    ]
  },
  "routes": [
    {
      "pattern": "zzik.qus0in.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker/index.ts",
  "vars": {
    "ACCESS_TEAM_DOMAIN": "qus0in.cloudflareaccess.com",
    "ACCESS_AUD": "d83bb3725ec247352d8a87ea9be8fc43a4aea78d68821b927a479f622bf29b79",
    "ALLOWED_EMAIL": "qus0in@gmail.com",
    "USAGE_READ_STORE": "d1",
    "USAGE_DATA_GENERATION": "0",
    "TREND_AA_PUBLIC": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zzik-usage",
      "database_id": "79d7f2d2-eb96-4748-8a4f-81b4b654f910",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORT_BUCKET",
      "bucket_name": "zzik-usage-export"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/15 * * * *",
      "7 */2 * * *",
      "17 0 * * *"
    ]
  }
}
